{
  "name": "watch-pr-wake-env-absolute",
  "owner": "MB07",
  "status": "active",
  "kind": "command",
  "argv": ["watch", "--status"],
  "env": {
    "HARNEXUS_CREW_PR_WAKE": "{{root}}/bin/custom-wake"
  },
  "commands": {
    "pr-wake": {
      "stdout": "{\"from\":\"path\"}\n"
    },
    "custom-wake": {
      "stdout": "{\"from\":\"env\"}\n"
    }
  }
}
