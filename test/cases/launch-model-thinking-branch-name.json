{
  "name": "launch-model-thinking-branch-name",
  "kind": "command",
  "argv": [
    "launch",
    "--request",
    "launch.json",
    "--model",
    "claude-opus-5-5",
    "--thinking",
    "low"
  ],
  "env": {
    "HARNEXUS_CALL_SOCKET": "{{bridge}}",
    "CODEX_THREAD_ID": "caller"
  },
  "seed": {
    "skills": "test/fixtures/task-skills"
  },
  "files": {
    "config/harnexus/task.json": "{\"templates\": {\"worker\": \"{{root}}/skills/task-session-launch/references/worker.md\", \"reviewer\": \"{{root}}/skills/task-review-cycle/references/reviewer.md\"}}",
    "work/launch.json": "{\"taskId\": \"TR1\", \"documentRefs\": [\"https://example.com/task\"], \"completionTarget\": \"draft_pr\", \"projectId\": \"project\", \"startingBranch\": \"feat/start\", \"displayName\": \"Named task\"}"
  },
  "bridge": [
    {
      "match": {
        "tool": "create_thread"
      },
      "answer": {
        "version": 1,
        "outcome": "done",
        "threadId": "w1",
        "model": "claude-opus-5-5",
        "effort": "low"
      }
    }
  ]
}
