{
  "name": "review-recover-is-for-cloud",
  "kind": "command",
  "argv": ["review", "--request", "review.json", "--recover", "discard"],
  "env": {
    "HARNEXUS_CALL_SOCKET": "{{bridge}}",
    "CODEX_THREAD_ID": "w1"
  },
  "seed": {
    "skills": "test/fixtures/task-skills"
  },
  "files": {
    "config/harnexus/task.json": "{\"templates\": {\"worker\": \"{{root}}/skills/task-session-launch/references/worker.md\", \"reviewer\": \"{{root}}/skills/task-review-cycle/references/reviewer.md\"}}",
    "work/review.json": "{\"taskId\": \"TR1\", \"workerAI\": \"Codex\", \"projectId\": \"project\", \"checkout\": \"{{home}}/.codex/worktrees/ab12/repo\", \"baseBranch\": \"base\", \"documentRefs\": [\"https://example.com/task\"], \"prUrl\": null}"
  },
  "git": [
    ["init", "-q", "{{home}}/.codex/worktrees/ab12/repo"],
    [
      "-C",
      "{{home}}/.codex/worktrees/ab12/repo",
      "commit",
      "--allow-empty",
      "-qm",
      "test: initial"
    ],
    ["-C", "{{home}}/.codex/worktrees/ab12/repo", "branch", "base"],
    [
      "-C",
      "{{home}}/.codex/worktrees/ab12/repo",
      "commit",
      "--allow-empty",
      "-qm",
      "test: candidate 1"
    ]
  ]
}
