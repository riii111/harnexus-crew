{
  "name": "cloud-prompt-file-starts-a-session",
  "kind": "command",
  "argv": ["cloud", "--prompt-file", "prompt.md"],
  "env": {
    "HARNEXUS_CALL_SOCKET": "{{bridge}}",
    "CODEX_THREAD_ID": "w1"
  },
  "files": {
    "work/prompt.md": "README を要約して\n"
  },
  "bridge": [
    {
      "match": {
        "tool": "cloud_open"
      },
      "answer": {
        "version": 1,
        "outcome": "done",
        "result": {
          "threadId": "cloud-chat",
          "cloudSessionId": "session_01NfjPqrDm5ZNRA1m484J4Kt",
          "url": "https://claude.ai/code/session_01NfjPqrDm5ZNRA1m484J4Kt",
          "alreadyLinked": true
        }
      }
    }
  ]
}
