{
  "name": "cloud-prompt-file-is-sent-as-it-is",
  "kind": "command",
  "argv": ["cloud", "--prompt-file", "prompt.md"],
  "env": {
    "HARNEXUS_CALL_SOCKET": "{{bridge}}",
    "CODEX_THREAD_ID": "w1"
  },
  "files": {
    "work/prompt.md": "\n  先頭と末尾の空白\r\n \n"
  },
  "bridge": [
    {
      "match": {
        "query": "capabilities"
      },
      "answer": {
        "version": 1,
        "outcome": "done",
        "operations": [
          "list_projects",
          "create_thread",
          "send_message_to_thread",
          "name_thread",
          "cloud_open"
        ]
      }
    },
    {
      "match": {
        "tool": "cloud_open"
      },
      "answer": {
        "version": 1,
        "outcome": "done",
        "result": {
          "threadId": "cloud-chat",
          "cloudSessionId": "session_01NfjPqrDm5ZNRA1m484J4Kt",
          "url": "https://claude.ai/code/session_01NfjPqrDm5ZNRA1m484J4Kt"
        }
      }
    }
  ]
}
