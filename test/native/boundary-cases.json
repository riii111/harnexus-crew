{
  "baseline": "51af56c5ee443de97e244be1c9eee97ebb34a6ac",
  "note": "The 21 cases the macOS spike verified for src/lib/socket.boundary.ts and run.boundary.ts, as inputs and expected results. Servers and commands are the files in mocks/. A case with a seam needs a way to hold a step of the boundary still, which the spike did with environment variables of its own; the Native boundary designs its own seam and keeps it out of the production CLI. Linux and the real full-queue case are not yet verified.",
  "socket": {
    "defaults": { "timeoutMs": 1000, "line": "{\"x\":1}" },
    "servers": {
      "answer": "bun mocks/socket_server.ts PATH answer",
      "silent": "bun mocks/socket_server.ts PATH silent",
      "backlog": "python3 mocks/socket_server.py PATH backlog",
      "drip": "python3 mocks/socket_server.py PATH drip 5 0.3",
      "noread": "python3 mocks/socket_server.py PATH noread",
      "stale": "an answer server killed after it created PATH, so the socket file remains"
    },
    "cases": [
      {
        "id": "S1-roundtrip",
        "server": "answer",
        "expect": { "outcome": "done" }
      },
      {
        "id": "S2-missing",
        "server": null,
        "expect": {
          "outcome": "not_sent",
          "code": "ENOENT",
          "connected": false
        }
      },
      {
        "id": "S3-no-answer",
        "server": "silent",
        "expect": {
          "outcome": "unknown",
          "code": "ETIMEDOUT",
          "connected": true
        },
        "elapsedMs": [800, 1600]
      },
      {
        "id": "S4-stale",
        "server": "stale",
        "expect": {
          "outcome": "not_sent",
          "code": "ECONNREFUSED",
          "connected": false
        }
      },
      {
        "id": "S5-empty-probe",
        "server": "answer",
        "line": "",
        "expect": { "outcome": "done", "answer": "" }
      },
      {
        "id": "C1-real-backlog-full",
        "server": "backlog",
        "expect": {
          "outcome": "not_sent",
          "code": "ECONNREFUSED",
          "connected": false
        },
        "platform": "macOS: a full queue refuses at once; on Linux a full queue is expected to block the connect, which only the deadline ends"
      },
      {
        "id": "C2-connect-timeout-injected",
        "server": "answer",
        "seam": "connect keeps answering EAGAIN",
        "expect": {
          "outcome": "not_sent",
          "code": "ETIMEDOUT",
          "connected": false
        },
        "elapsedMs": [800, 1600],
        "also": "other tasks keep running during the wait"
      },
      {
        "id": "C3-connect-eventual-success-injected",
        "server": "answer",
        "seam": "connect answers EAGAIN 20 times",
        "expect": { "outcome": "done", "connectAttempts": 21 }
      },
      {
        "id": "C4-single-total-deadline-injected",
        "server": "drip",
        "seam": "connect answers EAGAIN 50 times, about 500 ms in total",
        "expect": {
          "outcome": "unknown",
          "code": "ETIMEDOUT",
          "connected": true
        },
        "elapsedMs": [800, 1600],
        "connectedAtMs": [400, 800],
        "also": "connect, write and read share one deadline"
      },
      {
        "id": "C5-slow-response",
        "server": "drip",
        "expect": {
          "outcome": "unknown",
          "code": "ETIMEDOUT",
          "connected": true
        },
        "elapsedMs": [800, 1600]
      },
      {
        "id": "C6-peer-never-reads",
        "server": "noread",
        "line": "x repeated 65536 times",
        "expect": {
          "outcome": "unknown",
          "code": "ETIMEDOUT",
          "connected": true
        },
        "elapsedMs": [800, 1600]
      }
    ]
  },
  "process": {
    "defaults": { "timeoutMs": 1000, "killGraceMs": 500, "stdin": "" },
    "cases": [
      {
        "id": "E1-missing-command",
        "command": ["/nonexistent/cmd"],
        "expect": { "started": false, "ended": "failed" }
      },
      {
        "id": "E2-no-execute-permission",
        "command": ["mocks/noexec.sh"],
        "expect": { "started": false, "ended": "failed" }
      },
      {
        "id": "E3-bad-shebang",
        "command": ["mocks/badshebang.sh"],
        "expect": { "started": false, "ended": "failed" }
      },
      {
        "id": "E4-program-exits-127",
        "command": ["/bin/sh", "-c", "exit 127"],
        "expect": { "started": true, "ended": "exit", "status": 127 }
      },
      {
        "id": "E5-preexec-timeout-injected",
        "command": ["touch", "MARKER"],
        "timeoutMs": 300,
        "killGraceMs": 200,
        "seam": "the child stops 1000 ms before exec",
        "expect": { "started": true, "ended": "timeout" },
        "elapsedMs": [250, 900],
        "also": "the marker file is never created"
      },
      {
        "id": "E5-control-preexec-completes",
        "command": ["touch", "MARKER"],
        "timeoutMs": 2000,
        "killGraceMs": 200,
        "seam": "the child stops 100 ms before exec",
        "expect": { "started": true, "ended": "exit", "status": 0 },
        "also": "the marker file is created"
      },
      {
        "id": "P1-stdin-output-utf8",
        "command": ["/bin/sh", "mocks/child.sh", "echo"],
        "timeoutMs": 3000,
        "killGraceMs": 300,
        "stdin": "hello-stdin",
        "expect": {
          "started": true,
          "ended": "exit",
          "status": 3,
          "stdout": "hello-stdinあ\n",
          "stderr": "err-line\n"
        },
        "also": "a UTF-8 character split across two writes is read whole"
      },
      {
        "id": "P3-grandchild-ignores-term",
        "command": ["/bin/sh", "mocks/child.sh", "term-ok", "PIDFILE"],
        "expect": { "started": true, "ended": "timeout", "status": 143 },
        "elapsedMs": [1200, 2300],
        "also": "the leader and the grandchild are both gone afterwards"
      },
      {
        "id": "P4-leader-ignores-term",
        "command": ["/bin/sh", "mocks/child.sh", "ignore-term", "PIDFILE"],
        "expect": { "started": true, "ended": "timeout", "signal": 9 },
        "elapsedMs": [1200, 2300],
        "also": "the leader and its sleeping child are both gone afterwards"
      },
      {
        "id": "P5-output-limit",
        "command": ["/bin/sh", "-c", "echo $$ > PIDFILE; exec yes"],
        "timeoutMs": 10000,
        "expect": { "started": true, "ended": "output-limit" },
        "also": "the output kept never exceeds 16 MiB"
      }
    ]
  },
  "stillOpen": [
    "several children started at once: each exec notification reaches its own parent, and a pipe end passed to one child does not delay the end of another child's output",
    "setpgid failure before exec",
    "the same cases on Linux, with a real full queue and a real deadline"
  ]
}
